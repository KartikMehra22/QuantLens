DATABASE_URL=sqlite:///./quantlens.db
# PostgreSQL: postgresql+psycopg://quantlens:local-development@localhost:55433/quantlens
# Deployments must set a persistent random secret. Local mode creates .jwt-secret.
JWT_SECRET=
TOKEN_MINUTES=15
REFRESH_DAYS=7
RESET_MINUTES=10
AUTO_MIGRATE=true
ALLOW_DEMO=true
RATE_LIMITS_ENABLED=true
SYNC_POLL_SECONDS=60
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:8082
# Empty SMTP_HOST stores development reset messages privately in .outbox.
SMTP_HOST=
SMTP_PORT=1025
SMTP_TLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=QuantLens <no-reply@quantlens.local>
OUTBOX_DIR=.outbox
