DATABASE_URL=sqlite:///./quantlens.db
# PostgreSQL alternative: postgresql+psycopg://quantlens:local-development@localhost:55433/quantlens
# Set a random secret before deploying. Local mode creates an ignored .jwt-secret file.
JWT_SECRET=
TOKEN_MINUTES=60
ALLOW_DEMO=true
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:8082
