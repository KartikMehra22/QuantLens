  "components": {
    "schemas": {
      "CsvInput": {
        "properties": {
          "instrument_id": {
            "type": "string",
            "maxLength": 30,
            "title": "Instrument Id"
          },
          "csv_text": {
            "type": "string",
            "maxLength": 2000000,
            "minLength": 1,
            "title": "Csv Text"
          }
        },
        "type": "object",
        "required": [
          "instrument_id",
          "csv_text"
        ],
        "title": "CsvInput"
      },
      "EvaluationInput": {
        "properties": {
          "training_window": {
            "type": "integer",
            "maximum": 1000.0,
            "minimum": 252.0,
            "title": "Training Window",
            "default": 504
          },
          "test_days": {
            "type": "integer",
            "maximum": 252.0,
            "minimum": 5.0,
            "title": "Test Days",
            "default": 60
          }
        },
        "type": "object",
        "title": "EvaluationInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HoldingInput": {
        "properties": {
          "instrument_id": {
            "type": "string",
            "maxLength": 30,
            "title": "Instrument Id"
          },
          "quantity": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100000000.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Quantity"
          },
          "average_cost": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100000000.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Average Cost"
          }
        },
        "type": "object",
        "required": [
          "instrument_id",
          "quantity",
          "average_cost"
        ],
        "title": "HoldingInput"
      },
      "Login": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "Login"
      },
      "PortfolioInput": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Name"
          },
          "data_mode": {
            "type": "string",
            "enum": [
              "synthetic",
              "yahoo",
              "csv"
            ],
            "title": "Data Mode",
            "default": "synthetic"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "PortfolioInput"
      },
      "ProfileInput": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "ProfileInput"
      },
      "RefreshInput": {
        "properties": {
          "refresh_token": {
            "type": "string",
            "maxLength": 200,
            "minLength": 20,
            "title": "Refresh Token"
          }
        },
        "type": "object",
        "required": [
          "refresh_token"
        ],
        "title": "RefreshInput"
      },
      "Register": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "title": "Password"
          },
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password",
          "name"
        ],
        "title": "Register"
      },
      "ResetConfirm": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "code": {
            "type": "string",
            "pattern": "^\\d{8}$",
            "title": "Code"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "code",
          "password"
        ],
        "title": "ResetConfirm"
      },
      "ResetRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          }
        },
        "type": "object",
        "required": [
          "email"
        ],
        "title": "ResetRequest"
      },
      "ScenarioInput": {
        "properties": {
          "shock": {
            "type": "number",
            "maximum": 5.0,
            "minimum": -1.0,
            "title": "Shock",
            "default": -0.1
          },
          "overrides": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "maxProperties": 100,
            "title": "Overrides"
          }
        },
        "type": "object",
        "title": "ScenarioInput"
      },
      "SyncSettings": {
        "properties": {
          "auto_sync": {
            "type": "boolean",
            "title": "Auto Sync"
          }
        },
        "type": "object",
        "required": [
          "auto_sync"
        ],
        "title": "SyncSettings"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
